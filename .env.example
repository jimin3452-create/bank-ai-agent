# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
POSTGRES_DB=bank
DATABASE_URL=postgresql://bank:bank@localhost:5433/bank

# JWT 서명 키 (충분히 긴 임의 문자열)
JWT_SECRET=

# 카드번호 암호화 키 (32바이트 base64)
CARD_ENCRYPTION_KEY=

# Gemini API (백엔드에서만 사용. NEXT_PUBLIC_ 변수에 넣지 말 것)
GEMINI_API_KEY=
# 선택: 사용할 Gemini 모델(비워 두면 기본값). 모델명은 공식 문서로 확인해서 넣는다.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_VERSION=v1beta

# 개발용 메일 (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# 시연용 가상 계정 값 (scripts/seed_demo.py가 읽음. 로컬 개발 전용 예시값이며 실제 계정과 무관)
DEMO_PASSWORD=Demo!2345
DEMO_PIN=246810
DEMO_ACCOUNT_PASSWORD=1357
